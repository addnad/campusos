generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// How confident we are that a piece of curriculum data is correct.
/// Only VERIFIED is prefilled to new students.
enum Confidence {
  STUDENT_SUPPLIED
  CORROBORATED
  VERIFIED
}

/// University, polytechnic, or college of education. Students pick the
/// type before the school, so the list they see is never mixed.
/// Part-time is a distinct offering, not a student attribute: it runs
/// longer, times differently, and sequences courses differently. It
/// belongs to the programme so the prefill is never ambiguous.
enum StudyMode {
  FULL_TIME
  PART_TIME_WEEKDAY
  PART_TIME_WEEKEND
  SANDWICH
  DISTANCE
}

enum InstitutionKind {
  UNIVERSITY
  POLYTECHNIC
  COLLEGE_OF_EDUCATION
  OTHER
}

/// Seeded and maintained by CampusOS. Finite, public, changes yearly.
model Institution {
  id         String          @id @default(cuid())
  name       String
  shortName  String          @unique
  kind       InstitutionKind
  state      String?
  campuses   Campus[]
  programmes Programme[]
  courses    Course[]
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@index([kind])
}

/// A physical site. Campus is a hard boundary, not a filter: a student
/// picks one and never sees anything outside it. Different lecturers,
/// halls, timetables and communities. Single-campus institutions get one
/// row that is auto-selected and never shown.
model Campus {
  id            String      @id @default(cuid())
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  institutionId String
  name          String
  isPrimary     Boolean     @default(false)
  programmes    Programme[]
  courses       Course[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([institutionId, name])
}

/// Programme, not department (ADR-001). Seeded by CampusOS.
model Programme {
  id            String       @id @default(cuid())
  institution   Institution  @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  institutionId String
  campus        Campus       @relation(fields: [campusId], references: [id], onDelete: Cascade)
  campusId      String
  name          String
  award         String
  studyMode     StudyMode    @default(FULL_TIME)
  /// How many years the ladder runs. Full-time ND is 2; part-time ND is
  /// 3 (six semesters). Degrees are 4, or 5 where the programme is.
  years         Int          @default(2)
  curricula     Curriculum[]
  profiles      StudentProfile[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@unique([campusId, name, award, studyMode])
  @@index([institutionId])
}

/// The course list for one programme, level and semester.
/// Mostly student-built. Semester is 1 or 2 nationwide.
model Curriculum {
  id          String             @id @default(cuid())
  programme   Programme          @relation(fields: [programmeId], references: [id], onDelete: Cascade)
  programmeId String
  level       String
  semester    Int
  /// 0 means current / unversioned. A real intake year (2023) versions
  /// the curriculum so a cohort keeps its own course list. Not nullable:
  /// null in a compound unique never matches, so the constraint would not hold.
  intakeYear  Int                @default(0)
  entries     CurriculumEntry[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@unique([programmeId, level, semester, intakeYear])
}

/// The general academic concept, shared across institutions (ADR-002).
/// Entrepreneurship is BAM 126 at a polytechnic and ENT 202 at LASU.
model Subject {
  id      String   @id @default(cuid())
  name    String   @unique
  courses Course[]
}

/// One institution's course. Identity is institution + normalisedCode:
/// CSC 201 at LASU and CSC 201 at UNILAG are unrelated.
/// Not scoped to programme, so GNS 201 is one course across all of them.
model Course {
  id             String            @id @default(cuid())
  institution    Institution       @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  institutionId  String
  campus         Campus            @relation(fields: [campusId], references: [id], onDelete: Cascade)
  campusId       String
  /// Uppercased, non-alphanumerics stripped. "acc-223" and "ACC 223" both -> "ACC223"
  normalisedCode String
  /// What a student actually typed, for display.
  displayCode    String
  title          String
  subject        Subject?          @relation(fields: [subjectId], references: [id])
  subjectId      String?
  confidence     Confidence        @default(STUDENT_SUPPLIED)
  /// Set when a correction merges this course into another.
  mergedInto     Course?           @relation("CourseMerge", fields: [mergedIntoId], references: [id])
  mergedIntoId   String?
  mergedFrom     Course[]          @relation("CourseMerge")
  entries        CurriculumEntry[]
  enrolments     Enrolment[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@unique([campusId, normalisedCode])
  @@index([institutionId])
  @@index([subjectId])
}

/// A course's place in one curriculum: its units and whether it is
/// compulsory. Units live here because the same course can carry
/// different weight in different programmes.
model CurriculumEntry {
  id           String     @id @default(cuid())
  curriculum   Curriculum @relation(fields: [curriculumId], references: [id], onDelete: Cascade)
  curriculumId String
  course       Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId     String
  units        Int
  compulsory   Boolean    @default(true)
  /// LASU lists courses in a programme's table that its own students
  /// must not take. Excluded entries are never prefilled.
  excluded     Boolean    @default(false)
  confidence   Confidence @default(STUDENT_SUPPLIED)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([curriculumId, courseId])
}

model User {
  id            String           @id @default(cuid())
  email         String           @unique
  emailVerified DateTime?
  name          String?
  image         String?
  passwordHash  String?

  /// Public handle as chosen, for display. Unique on handleLower.
  handle        String?
  /// Lowercased handle. Uniqueness is checked here so Tunde and tunde
  /// cannot both exist: same-looking handles are an impersonation vector.
  handleLower   String?          @unique
  /// Gates the once-a-year change.
  handleSetAt   DateTime?

  accounts      Account[]
  sessions      Session[]
  profiles      StudentProfile[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
}

/// OAuth accounts linked to a user. Shape is dictated by @auth/prisma-adapter.
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

/// A handle that is not available even though no active user holds it.
/// Covers the 3-month grace after deletion, and old handles after a rename,
/// so nobody can immediately claim a name someone was known by.
model HandleReservation {
  id          String   @id @default(cuid())
  handleLower String   @unique
  /// The user who held it, if the account still exists.
  formerUserId String?
  releasedAt  DateTime @default(now())
  /// Available again after this. releasedAt + 3 months.
  expiresAt   DateTime

  @@index([expiresAt])
}

/// One active profile per user in the MVP. The schema allows many so
/// transfers and ND -> HND are possible later without a migration.
model StudentProfile {
  id           String      @id @default(cuid())
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  programme    Programme   @relation(fields: [programmeId], references: [id])
  programmeId  String
  level        String
  semester     Int
  /// Optional. Sensitive: never exposed in URLs or to other students.
  matricNumber String?
  isActive     Boolean     @default(true)
  enrolments   Enrolment[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([userId])
}

/// What this student is actually carrying. The curriculum is a menu;
/// this is the truth. Carryovers, electives and drops live here.
/// Every screen in the app reads from this, never from Curriculum.
model Enrolment {
  id         String         @id @default(cuid())
  profile    StudentProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId  String
  course     Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId   String
  level      String
  semester   Int
  units      Int
  /// Stable per student per semester, assigned at enrolment.
  colourToken String
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@unique([profileId, courseId, level, semester])
  @@index([courseId])
}
