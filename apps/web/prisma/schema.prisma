generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Whether a student is currently taking a course. Communities pool
/// every student who ever enrolled, so a fresher can reach someone who
/// passed the course last year — that continuity is the point, and it is
/// what a semester WhatsApp group cannot do. Deadlines, notifications
/// and counts read ACTIVE only, so past students are not pinged about a
/// deadline that is not theirs.
enum EnrolmentStatus {
  ACTIVE
  COMPLETED
  DROPPED
}

/// How confident we are that a piece of curriculum data is correct.
/// Only VERIFIED is prefilled to new students.
enum Confidence {
  STUDENT_SUPPLIED
  CORROBORATED
  VERIFIED
}

/// University, polytechnic, or college of education. Students pick the
/// type before the school, so the list they see is never mixed.
/// Part-time is a distinct offering, not a student attribute: it runs
/// longer, times differently, and sequences courses differently. It
/// belongs to the programme so the prefill is never ambiguous.
enum StudyMode {
  FULL_TIME
  PART_TIME_WEEKDAY
  PART_TIME_WEEKEND
  SANDWICH
  DISTANCE
}

enum InstitutionKind {
  UNIVERSITY
  POLYTECHNIC
  COLLEGE_OF_EDUCATION
  OTHER
}

/// Seeded and maintained by CampusOS. Finite, public, changes yearly.
model Institution {
  id         String          @id @default(cuid())
  name       String
  shortName  String          @unique
  kind       InstitutionKind
  state      String?
  campuses   Campus[]
  programmes Programme[]
  courses    Course[]
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@index([kind])
}

/// A physical site. Campus is a hard boundary, not a filter: a student
/// picks one and never sees anything outside it. Different lecturers,
/// halls, timetables and communities. Single-campus institutions get one
/// row that is auto-selected and never shown.
model Campus {
  id            String      @id @default(cuid())
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  institutionId String
  name          String
  isPrimary     Boolean     @default(false)
  programmes    Programme[]
  courses       Course[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([institutionId, name])
}

/// Programme, not department (ADR-001). Seeded by CampusOS.
model Programme {
  id            String       @id @default(cuid())
  institution   Institution  @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  institutionId String
  campus        Campus       @relation(fields: [campusId], references: [id], onDelete: Cascade)
  campusId      String
  name          String
  /// Uppercased, non-alphanumerics stripped, for duplicate detection.
  /// "Computer Science" and "computer sciences" are not the same string
  /// but are the same programme, so near-matches are surfaced to the
  /// student before a new one is created.
  normalisedName String      @default("")
  award         String
  studyMode     StudyMode    @default(FULL_TIME)
  /// Student-declared programmes are shown but marked, so a typo does
  /// not sit next to sourced data looking equally authoritative.
  confidence    Confidence   @default(VERIFIED)
  /// How many years the ladder runs. Full-time ND is 2; part-time ND is
  /// 3 (six semesters). Degrees are 4, or 5 where the programme is.
  years         Int          @default(2)
  curricula     Curriculum[]
  profiles      StudentProfile[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@unique([campusId, name, award, studyMode])
  @@index([institutionId])
}

/// The course list for one programme, level and semester.
/// Mostly student-built. Semester is 1 or 2 nationwide.
model Curriculum {
  id          String             @id @default(cuid())
  programme   Programme          @relation(fields: [programmeId], references: [id], onDelete: Cascade)
  programmeId String
  level       String
  semester    Int
  /// 0 means current / unversioned. A real intake year (2023) versions
  /// the curriculum so a cohort keeps its own course list. Not nullable:
  /// null in a compound unique never matches, so the constraint would not hold.
  intakeYear  Int                @default(0)
  entries     CurriculumEntry[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@unique([programmeId, level, semester, intakeYear])
}

/// The general academic concept, shared across institutions (ADR-002).
/// Entrepreneurship is BAM 126 at a polytechnic and ENT 202 at LASU.
model Subject {
  id      String   @id @default(cuid())
  name    String   @unique
  courses Course[]
}

/// One institution's course. Identity is institution + normalisedCode:
/// CSC 201 at LASU and CSC 201 at UNILAG are unrelated.
/// Not scoped to programme, so GNS 201 is one course across all of them.
model Course {
  id             String            @id @default(cuid())
  institution    Institution       @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  institutionId  String
  campus         Campus            @relation(fields: [campusId], references: [id], onDelete: Cascade)
  campusId       String
  /// Uppercased, non-alphanumerics stripped. "acc-223" and "ACC 223" both -> "ACC223"
  normalisedCode String
  /// What a student actually typed, for display.
  displayCode    String
  title          String
  subject        Subject?          @relation(fields: [subjectId], references: [id])
  subjectId      String?
  confidence     Confidence        @default(STUDENT_SUPPLIED)
  /// Set when a correction merges this course into another.
  mergedInto     Course?           @relation("CourseMerge", fields: [mergedIntoId], references: [id])
  mergedIntoId   String?
  mergedFrom     Course[]          @relation("CourseMerge")
  entries        CurriculumEntry[]
  enrolments     Enrolment[]
  sessions       ClassSession[]
  assessments    Assessment[]
  communities    Community[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@unique([campusId, normalisedCode])
  @@index([institutionId])
  @@index([subjectId])
}

/// A course's place in one curriculum: its units and whether it is
/// compulsory. Units live here because the same course can carry
/// different weight in different programmes.
model CurriculumEntry {
  id           String     @id @default(cuid())
  curriculum   Curriculum @relation(fields: [curriculumId], references: [id], onDelete: Cascade)
  curriculumId String
  course       Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId     String
  units        Int
  compulsory   Boolean    @default(true)
  /// LASU lists courses in a programme's table that its own students
  /// must not take. Excluded entries are never prefilled.
  excluded     Boolean    @default(false)
  confidence   Confidence @default(STUDENT_SUPPLIED)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([curriculumId, courseId])
}

model User {
  id            String           @id @default(cuid())
  email         String           @unique
  emailVerified DateTime?
  name          String?
  image         String?
  passwordHash  String?

  /// Public handle as chosen, for display. Unique on handleLower.
  handle        String?
  /// Lowercased handle. Uniqueness is checked here so Tunde and tunde
  /// cannot both exist: same-looking handles are an impersonation vector.
  handleLower   String?          @unique
  /// Gates the once-a-year change.
  handleSetAt   DateTime?

  /// Set directly in the database. No self-service path to it, and no
  /// UI that grants it: moderation decisions come from a person, not
  /// from a threshold.
  isStaff       Boolean          @default(false)

  /// Set when removals in separate rooms suggest a pattern rather than a
  /// bad afternoon. Reviewed by a person; nothing automatic bans anyone
  /// from the whole product.
  flaggedAt     DateTime?

  accounts      Account[]
  sessions      Session[]
  profiles      StudentProfile[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
}

/// OAuth accounts linked to a user. Shape is dictated by @auth/prisma-adapter.
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

/// A handle that is not available even though no active user holds it.
/// Covers the 3-month grace after deletion, and old handles after a rename,
/// so nobody can immediately claim a name someone was known by.
model HandleReservation {
  id          String   @id @default(cuid())
  handleLower String   @unique
  /// The user who held it, if the account still exists.
  formerUserId String?
  releasedAt  DateTime @default(now())
  /// Available again after this. releasedAt + 3 months.
  expiresAt   DateTime

  @@index([expiresAt])
}

/// One active profile per user in the MVP. The schema allows many so
/// transfers and ND -> HND are possible later without a migration.
model StudentProfile {
  id           String      @id @default(cuid())
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  programme    Programme   @relation(fields: [programmeId], references: [id])
  programmeId  String
  level        String
  semester     Int
  /// Optional. Sensitive: never exposed in URLs or to other students.
  matricNumber String?
  isActive     Boolean     @default(true)

  /// When this semester ends, as the student reported it. A property of
  /// the campus really — every 100-level student shares it — but stored
  /// per profile until enough students agree for it to be promoted.
  /// Always editable: a strike can move it by months.
  semesterEndsAt   DateTime?
  /// When the next one starts, if they know.
  nextSemesterAt   DateTime?
  /// Last time we asked. The prompt returns weekly until answered, and
  /// "I do not know" counts as an answer for a while so a student who
  /// genuinely does not know is not nagged.
  datePromptedAt   DateTime?
  /// Set when they say they do not know, so we back off rather than ask
  /// again next week.
  dateUnknownAt    DateTime?
  enrolments   Enrolment[]
  tasks        Task[]
  sessions     ClassSession[]
  assessments  Assessment[]
  dismissed    DismissedSuggestion[]
  memberships  CommunityMember[]
  messages     Message[]
  reportsMade  Report[]             @relation("ReportsMade")
  reactions    Reaction[]
  presence     Presence[]
  mentions     Mention[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([userId])
}

/// What this student is actually carrying. The curriculum is a menu;
/// this is the truth. Carryovers, electives and drops live here.
/// Every screen in the app reads from this, never from Curriculum.
model Enrolment {
  id         String         @id @default(cuid())
  profile    StudentProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId  String
  course     Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId   String
  level      String
  semester   Int
  /// "2025/2026". Without this a student repeating a course overwrites
  /// their first attempt: same profile, same course, same level, same
  /// semester. History matters — a course passed last year is not the
  /// same as one being taken now.
  session    String          @default("")
  units      Int
  status     EnrolmentStatus @default(ACTIVE)
  /// Stable per student per semester, assigned at enrolment.
  colourToken String
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@unique([profileId, courseId, session, semester])
  @@index([courseId])
  @@index([courseId, status])
}

/// What a student has done about a shared assignment. Automatic means it
/// appears on every coursemate's timeline; DISMISSED removes it from
/// theirs, and enough dismissals are a signal it should not be there.
enum TaskState {
  PENDING
  DONE
  DISMISSED
}

enum AssessmentKind {
  ASSIGNMENT
  TEST
  EXAM
  PRESENTATION
  PROJECT
}

/// A recurring class. Recurring rather than per-instance so a student
/// enters "Monday 10:00, LT4" once instead of fifteen times. Cancelled
/// and moved classes need an exceptions table; not yet.
model ClassSession {
  id         String         @id @default(cuid())
  course     Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId   String
  /// Owned by the student who entered it. A coursemate's entry reaches
  /// them as a suggestion they can accept, never as a fact imposed on
  /// their timeline — lecturers split groups, and a timetable that is
  /// right for one student can be wrong for another.
  profile    StudentProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId  String
  /// 1 = Monday .. 7 = Sunday, matching ISO weekday numbering.
  weekday    Int
  /// Minutes from midnight. Comparable and sortable without timezone
  /// arithmetic, which a wall-clock timetable does not need.
  startsAt   Int
  endsAt     Int
  venue      String?
  lecturer   String?
  confidence Confidence     @default(STUDENT_SUPPLIED)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@index([courseId, weekday])
  @@index([profileId])
}

/// Assignments, tests and exams. Shared by default: one student adds it
/// and everyone taking the course sees it, the same corroboration model
/// as course codes. A private one is visible only to whoever added it.
model Assessment {
  id          String         @id @default(cuid())
  course      Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId    String
  /// Owned by whoever entered it; coursemates see it as a suggestion.
  profile     StudentProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId   String
  kind        AssessmentKind @default(ASSIGNMENT)
  title       String
  details     String?
  dueAt       DateTime
  venue       String?
  /// Private assessments are never offered to coursemates at all.
  isPrivate   Boolean        @default(false)
  confidence  Confidence     @default(STUDENT_SUPPLIED)
  tasks       Task[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([courseId, dueAt])
  @@index([profileId])
}

/// One student's state on one assessment. Absent means untouched, which
/// still shows as pending — a row is only written when they act.
model Task {
  id           String         @id @default(cuid())
  profile      StudentProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId    String
  assessment   Assessment     @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  assessmentId String
  state        TaskState      @default(PENDING)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@unique([profileId, assessmentId])
  @@index([profileId, state])
}

/// A suggestion the student has waved away. Stored by shape, not by row:
/// a suggestion is a computed group of coursemates' entries, so there is
/// no id to point at, and a coursemate adding an identical entry
/// tomorrow must not resurrect it.
///
/// The key is built the same way the suggestion group is:
/// class      -> "class:<courseId>:<weekday>:<10-minute bucket>"
/// assessment -> "due:<courseId>:<due date>:<kind>"
model DismissedSuggestion {
  id        String         @id @default(cuid())
  profile   StudentProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId String
  key       String
  createdAt DateTime       @default(now())

  @@unique([profileId, key])
  @@index([profileId])
}

/// A room attached to a shared academic responsibility (ADR-004). Keyed
/// on the course, which is already campus-scoped — UNILAG's GNS 101 and
/// UI's are different rooms, and so are Yaba's and Epe's.
///
/// Opens when three students are enrolled in the same course, session,
/// level and semester. Joining is explicit: enrolment makes you eligible,
/// not a member.
model Community {
  id        String            @id @default(cuid())
  course    Course            @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId  String
  /// The cohort this room serves. A room for 100 Level first semester is
  /// not the room for 300 Level, even in the same course.
  level     String
  semester  Int
  members   CommunityMember[]
  messages  Message[]
  presence  Presence[]
  createdAt DateTime          @default(now())

  @@unique([courseId, level, semester])
}

enum MemberState {
  ACTIVE
  TIMED_OUT
  REMOVED
}

/// Membership, and where moderation state lives. A warning or a timeout
/// is about one person in one room, not about their account.
model CommunityMember {
  id          String         @id @default(cuid())
  community   Community      @relation(fields: [communityId], references: [id], onDelete: Cascade)
  communityId String
  profile     StudentProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId   String
  state       MemberState    @default(ACTIVE)
  /// Upheld reports against them here. Three means permanent removal.
  strikes     Int            @default(0)
  /// Set when timed out; they can post again after it passes.
  mutedUntil  DateTime?
  /// When they last opened the room. Anything after this is unread —
  /// without it a student has to open every room to find out whether
  /// anything happened.
  lastReadAt  DateTime?
  joinedAt    DateTime       @default(now())

  @@unique([communityId, profileId])
  @@index([profileId])
}

model Message {
  id          String           @id @default(cuid())
  community   Community        @relation(fields: [communityId], references: [id], onDelete: Cascade)
  communityId String
  author      StudentProfile   @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId    String
  body        String
  /// A join announcement is a message so it sits in the stream in order,
  /// but it is not something a person said: no reactions, no replies, no
  /// reporting.
  isSystem    Boolean          @default(false)

  /// Attachment. The store is private, so this is a pathname rather than
  /// a URL — a signed link is generated per request for room members
  /// only, which a public store would not allow.
  filePath    String?
  fileType    String?
  fileSize    Int?
  fileName    String?
  /// Forty people discussing one assignment is unreadable without this.
  /// SetNull rather than Cascade: deleting a message should not take the
  /// replies to it with it.
  replyTo     Message?         @relation("Replies", fields: [replyToId], references: [id], onDelete: SetNull)
  replyToId   String?
  replies     Message[]        @relation("Replies")
  reactions   Reaction[]
  mentions    Mention[]
  /// Soft delete: removing the row would orphan reports made against it.
  deletedAt   DateTime?
  reports     Report[]
  createdAt   DateTime         @default(now())

  @@index([communityId, createdAt])
  @@index([replyToId])
}

enum ReportState {
  OPEN
  UPHELD
  DISMISSED
}

/// Students know what is abusive in Pidgin, Yoruba, Hausa and Igbo far
/// better than a wordlist does. Reports are the primary mechanism;
/// automated matching is narrow and secondary.
model Report {
  id         String      @id @default(cuid())
  message    Message     @relation(fields: [messageId], references: [id], onDelete: Cascade)
  messageId  String
  reporter   StudentProfile @relation("ReportsMade", fields: [reporterId], references: [id], onDelete: Cascade)
  reporterId String
  /// A category from REPORT_REASONS, so reports can be counted.
  reason     String?
  /// Optional detail, for "something else" or added context.
  note       String?
  state      ReportState @default(OPEN)
  createdAt  DateTime    @default(now())

  @@unique([messageId, reporterId])
  @@index([state])
}

/// One emoji from one student on one message. Unique per pair, so a tap
/// toggles rather than stacking.
model Reaction {
  id        String         @id @default(cuid())
  message   Message        @relation(fields: [messageId], references: [id], onDelete: Cascade)
  messageId String
  profile   StudentProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId String
  emoji     String
  createdAt DateTime       @default(now())

  @@unique([messageId, profileId, emoji])
  @@index([messageId])
}

/// Who is in a room right now, and who is typing. Serverless functions
/// share no memory and polling holds no connection, so presence lives in
/// the database: each poll writes a heartbeat and reads back the rest.
/// One row per student per room, updated in place.
model Presence {
  id          String    @id @default(cuid())
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  communityId String
  profile     StudentProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId   String
  /// Online if this is within the last ~20 seconds.
  seenAt      DateTime  @updatedAt
  /// Typing if this is in the future. Set a few seconds ahead on each
  /// keystroke so it lapses on its own when they stop.
  typingUntil DateTime?

  @@unique([communityId, profileId])
  @@index([communityId, seenAt])
}

/// Who a message named. Stored rather than re-parsed so unread mentions
/// can be counted, and resolved only against room members: naming
/// someone who is not in the room is just text.
model Mention {
  id        String         @id @default(cuid())
  message   Message        @relation(fields: [messageId], references: [id], onDelete: Cascade)
  messageId String
  profile   StudentProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId String
  createdAt DateTime       @default(now())

  @@unique([messageId, profileId])
  @@index([profileId, createdAt])
}
